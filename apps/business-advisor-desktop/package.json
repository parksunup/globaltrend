{
  "name": "globaltrend-business-advisor-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Local desktop shell for the GlobalTrend business privacy advisor",
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-renderer.mjs",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win zip --x64"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "org.globaltrend.business-advisor",
    "productName": "GlobalTrend 기업 개인정보 보호 도우미",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "THIRD-PARTY-NOTICE.md",
      "third-party/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ],
      "artifactName": "GlobalTrend-Business-Advisor-${version}-Windows-${arch}.${ext}"
    }
  }
}
