{
  "manifest_version": 3,
  "name": "국제요정 NotebookLM 연결",
  "version": "0.3.1",
  "description": "연결한 국제요정 작업실의 공개 자료를 NotebookLM에 전달하고 생성된 음성을 돌려보냅니다.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "cookies"
  ],
  "host_permissions": [
    "https://globaltrend-six.vercel.app/*",
    "https://notebook.google.com/*",
    "https://notebooklm.google.com/*",
    "https://*.google.com/*"
  ],
  "optional_host_permissions": [
    "https://*.vercel.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "국제요정 작업실 연결"
  },
  "content_scripts": [
    {
      "matches": ["https://globaltrend-six.vercel.app/*"],
      "js": ["studio.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://notebook.google.com/*",
        "https://notebooklm.google.com/*"
      ],
      "js": [
        "capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://notebook.google.com/*",
        "https://notebooklm.google.com/*"
      ],
      "js": [
        "notebook.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
